# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output
dist/
*.tsbuildinfo

# Cache
.docgen-cache/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.production

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn

# Testing
coverage/
.nyc_output/

# Temporary
tmp/
temp/
*.tmp

# Examples output
examples/*/docs/

# Generated documentation output. DocGen writes docs for whatever codebase you
# point it at, so this output can contain third-party or proprietary code
# details. Never commit generated docs — regenerate them locally instead.
docs-output/
*-docs/
*-docs-*/
